def cube_frame(width, height, frame):
    grid = [[" "] * width for _ in range(height)]
    phase = frame * math.tau / 48
    yaw, pitch = math.cos(phase), math.sin(phase)
    nodes = []
    for index in range(8):
        x, y, z = (1 if index & (1 << coordinate) else -1 for coordinate in range(3))
        x, z = x * yaw - z * pitch, x * pitch + z * yaw
        y, z = y * .92 - z * .39, y * .39 + z * .92
        distance = 4.1 + z * .55
        nodes.append((int(width / 2 + x * height * 2.0 / distance),
                      int(height / 2 + y * height * 1.46 / distance), z))
    for index, (x1, y1, z1) in enumerate(nodes):
        for bit in (1, 2, 4):
            other = index ^ bit
            if other < index:
                continue
            x2, y2, z2 = nodes[other]
            steps = max(abs(x1 - x2), abs(y1 - y2), 1)
            for step in range(steps + 1):
                x = round(x1 + (x2 - x1) * step / steps)
                y = round(y1 + (y2 - y1) * step / steps)
                if 0 <= y < height and 0 <= x < width:
                    grid[y][x] = "+" if step in (0, steps) else "#" if z1 + z2 < 0 else "."
    return "\n".join("".join(row).rstrip() for row in grid)


def show_blackbox():
    size = shutil.get_terminal_size((80, 24))
    width, height = min(114, size.columns - 2), min(32, size.lines - 2)
    art = [*SKULL, "", *TITLE] if width >= 60 else ["+--------+", "|  X  X  |", "|   /\\   |", "|  ====  |", "+--------+", " BLACKBOX"]
    art = "\n".join(line.strip("\n").rstrip().center(max(12, width)) for line in art).rstrip()
    if sys.stdout.isatty() and width >= 19 and height >= 8:
        print("\033[?1049h\033[?25l", end="", flush=True)
        try:
            for frame in range(49):
                print("\033[H\033[2J\033[38;5;79m" + cube_frame(width, height, frame) + "\033[0m", end="", flush=True)
                time.sleep(.043)
            for _ in range(12):
                print("\033[H\033[2J\033[38;5;159m" + art + "\033[0m", end="", flush=True)
                time.sleep(.043)
        except KeyboardInterrupt:
            pass
        finally:
            print("\033[0m\033[?25h\033[?1049l", end="", flush=True)
    print(art)


def terminal_session():
    session = os.environ.get("BLACKBOX_TERMINAL_SESSION")
    if not session:
        raise ValueError("Open a shell in the Pure Code wallpaper to use game-practice commands.")
    return session


def set_option(key, value):
    key, value = key.lstrip("-"), value.removeprefix("=")
    parsed = parse_setting(key, value)
    if key == "idleFront":
        if service("IdleRoom", parsed).strip() != "true":
            raise ValueError("Room changes require Idle mode.")
    else:
        service("Configure", key, json.dumps(parsed))
    current = json.loads(service("Options")).get(key)
    if isinstance(parsed, (bool, int, float)):
        accepted = str(current).lower() == str(parsed).lower() or isinstance(parsed, (int, float)) and current == parsed
    else:
        accepted = current == parsed
    if not accepted:
        raise ValueError(f"Blackbox did not apply {key}. Current value is {current!r}.")
    print(f"{key} = {current}")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "help":
        print_help(sys.argv[2:])
        return
    parser = BoxParser(prog="box", epilog="Run box help for the command tree and full reference.")
    commands = parser.add_subparsers(dest="command")
    for name, (_, description, _) in VERBS.items():
        commands.add_parser(name, help=description)
    child = commands.choices
    child["manual"].add_argument("--open", action="store_true")
    child["status"].add_argument("--json", action="store_true")
    child["options"].add_argument("section", nargs="?", choices=OPTIONS)
    child["get"].add_argument("key", choices=KEYS)
    child["set"].add_argument("key", choices=KEYS)
    child["set"].add_argument("value")
    child["theme"].add_argument("name", nargs="?", choices=(*THEMES, "custom", "reset"))
    for name in ("foreground", "background", "accent"):
        child["theme"].add_argument("--"+name)
    child["wallpaper"].add_argument("face", choices=(*ROOMS, "cube"))
    child["wallpaper"].add_argument("image")
    child["look"].add_argument("direction", choices=("left", "right", "up", "down"))
    child["room"].add_argument("face", choices=ROOMS)
    for name in ("files", "location"):
        child[name].add_argument("folder", default=".", nargs="?")
    child["pet"].add_argument("words", nargs=argparse.REMAINDER)
    child["report"].add_argument("text", nargs=argparse.REMAINDER)
    child["reset"].add_argument("selection", choices=("settings", "images"))
    child["reset"].add_argument("--yes", action="store_true")
    child["admin"].add_argument("-password", "--password")
    child["admin"].add_argument("--lock", action="store_true")
    debug = child["debug"].add_subparsers(dest="action", required=True)
    practice = debug.add_parser("practice")
    practice.add_argument("wave", choices=range(10, 151, 10), type=int, metavar="WAVE")
    practice.add_argument("--difficulty", choices=("normal", "hard", "insane"), default="normal")
    practice.add_argument("--build", choices=("standard", "star", "random"), default="standard")
    for action in DEBUG:
        if action != "practice":
            debug.add_parser(action).add_argument("value")

    args = parser.parse_args()
    if args.command == "me":
        show_blackbox()
    elif args.command == "manual":
        if args.open:
            subprocess.run(["xdg-open", str(MANUAL)], check=True)
        else:
            print(MANUAL.read_text(), end="")
    elif args.command == "status":
        state = json.loads(service("Status"))
        if args.json:
            print(json.dumps(state, indent=2))
        else:
            for key, value in state.items():
                print(f"{key:21} {value}")
    elif args.command == "options":
        state = json.loads(service("Options"))
        for name in (OPTIONS[args.section] if args.section else KEYS):
            print(f"{name:22} {state.get(name)}")
    elif args.command == "get":
        print(json.dumps(json.loads(service("Options")).get(args.key)))
    elif args.command == "set":
        set_option(args.key, args.value)
    elif args.command == "theme":
        if args.name == "reset":
            set_option("terminalPalette", "{}")
        elif args.name == "custom":
            current = json.loads(json.loads(service("Options")).get("terminalPalette", "{}"))
            current.update({name: getattr(args, name) for name in ("foreground", "background", "accent") if getattr(args, name)})
            set_option("terminalPalette", json.dumps(current))
        elif args.name:
            set_option("interfaceTheme", args.name)
        else:
            print("Interface themes  " + " · ".join(THEMES))
            print("Use box help theme for palette examples.")
    elif args.command == "look":
        if service("IdleTurn", args.direction).strip() != "true":
            raise ValueError("Wallpaper turns require an active Blackbox Idle session.")
    elif args.command == "room":
        if service("IdleRoom", args.face).strip() != "true":
            raise ValueError("Room selection requires an active Blackbox Idle session.")
    elif args.command == "wallpaper":
        set_option("wallpaper_" + args.face, args.image)
    elif args.command in ("files", "location"):
        folder = Path(args.folder).expanduser().resolve()
        if not folder.is_dir():
            raise ValueError("Folder not found.")
        if args.command == "location":
            print(folder)
        else:
            for entry in sorted(folder.iterdir(), key=lambda item: (not item.is_dir(), item.name.casefold())):
                name = "".join(letter if letter.isprintable() else repr(letter)[1:-1] for letter in entry.name)
                print(name + ("/" if entry.is_dir() else ""))
    elif args.command == "pet":
        words = args.words
        if not words or words[0] == "help":
            pet_help(*(words[1:3] + [""] * 2)[:2])
        else:
            reply = json.loads(service("PetCommand", json.dumps(words)))
            print(reply["message"], file=sys.stdout if reply["ok"] else sys.stderr)
            if not reply["ok"]:
                raise SystemExit(2)
    elif args.command == "report":
        message = " ".join(args.text)
        if service("BoxReport", message).strip() != "true":
            raise ValueError("Could not save the report.")
        print("Report saved locally." if message else "Opening the local bug reporter.")
    elif args.command == "reset":
        if not args.yes:
            raise ValueError("Add --yes to restore those defaults.")
        if service("BoxReset", args.selection).strip() != "true":
            raise ValueError("Blackbox settings are unavailable.")
    elif args.command == "admin":
        session = terminal_session()
        if args.lock:
            service("BoxLock", session)
            print("Game-practice commands locked.")
            return
        phrase = args.password.removeprefix("=") if args.password is not None else getpass.getpass("Game-practice phrase: ")
        if service("BoxAdmin", session, phrase).strip() != "true":
            raise ValueError("Game-practice phrase rejected.")
        print("Game-practice commands unlocked for this shell for 15 minutes. Run box help debug.")
    elif args.command == "debug":
        value = f"{args.difficulty},{args.wave},{args.build}" if args.action == "practice" else args.value
        if args.action in ("money", "unlocks"):
            value = str(as_bool(value)).lower()
        if service("BoxDebug", terminal_session(), args.action, value).strip() != "true":
            raise ValueError("Unlock this shell with box admin and use an unstarted practice run.")
        state = json.loads(service("Status"))
        key = {"practice": "startAt", "money": "debugMoney", "weapon": "debugWeapon",
               "weather": "debugLayer", "unlocks": "debugUnlocks"}[args.action]
        expected = args.wave if args.action == "practice" else as_bool(value) if args.action in ("money", "unlocks") else value
        if state.get(key) != expected:
            raise ValueError("Blackbox rejected that practice setting.")
        print("Practice setting applied.")
    else:
        print_help([])


if __name__ == "__main__":
    try:
        main()
    except (KeyError, ValueError) as error:
        print(f"box: {error}", file=sys.stderr)
        raise SystemExit(2)
    except (OSError, subprocess.SubprocessError):
        print("box: Blackbox is unavailable on this KDE session bus.", file=sys.stderr)
        raise SystemExit(1)
