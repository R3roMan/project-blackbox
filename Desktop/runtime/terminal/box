#!/usr/bin/env python3
"""Manage Blackbox from the Pure Code Konsole session."""
import argparse
import json
import math
import shutil
import sys
import time
from pathlib import Path
import subprocess

RPC = ("qdbus6", "org.projectblackbox.Desktop", "/Blackbox", "org.projectblackbox.Desktop.")
ROOMS = ("front", "left", "right", "up", "down", "back")
OPTIONS = {
    "idlePhaseMinutes": (int, (1, 120)),
    "idleFps": (int, (5, 30)),
    "detail": (int, (0, 3)),
    "frameLimit": (int, (20, 240)),
    "audioMaster": (float, (0, 1)),
    "audioMusic": (float, (0, 1)),
    "audioEffects": (float, (0, 1)),
    "audioAmbience": (float, (0, 1)),
    "audioInterface": (float, (0, 1)),
    "framing": (str, ("fill", "fit", "stretch", "16:9")),
    "interfaceTheme": (str, ("bloodShrine", "armory", "terminal", "dossier", "lockdown", "dark")),
    "transitionStyle": (str, ("cinematic", "soft")),
    "transitionStrength": (float, (0.4, 1.4)),
    "zoom": (float, (1, 1.4)),
    "mouseTurns": (bool, ()),
    "idlePet": (bool, ()),
    "motion": (bool, ()),
    "backgroundPlay": (bool, ()),
    "backgroundIdle": (bool, ()),
    "peekOverview": (bool, ()),
    "safeRendering": (bool, ()),
}


def service(method, *args):
    return subprocess.check_output([*RPC[:3], RPC[3] + method, *args], text=True, timeout=6)


SKULL = (
    "                    .----------------.                    ",
    "                .--'                  '--.                ",
    "             .-'      /\\        /\\      '-.             ",
    "            /       _/  \\______/  \\_       \\            ",
    "           |       /     ______     \\       |           ",
    "           |      |  ___/      \\___  |      |           ",
    "           |      | (####) /\\ (####) |      |           ",
    "            \\     |       /__\\       |     /            ",
    "             '-.  \\_   ___||___   _/  .-'             ",
    "                '-._|  | |||| |  |_.-'                 ",
    "                     \\_|_||||_|_/                       ",
    "                         '----'                           ",
)
TITLE = (
    " BBB  L      A   CCC  K  K BBB   OOO  X   X ",
    " B  B L     A A C     K K  B  B O   O  X X  ",
    " BBB  L    AAAAA C    KK   BBB  O   O   X   ",
    " B  B L    A   A C    K K  B  B O   O  X X  ",
    " BBB  LLLL A   A  CCC K  K BBB   OOO  X   X ",
)


def cube_frame(width, height, frame):
    grid = [[" "] * width for _ in range(height)]
    phase = frame * math.tau / 48
    yaw, pitch = math.cos(phase), math.sin(phase)
    nodes = []
    for index in range(8):
        x, y, z = (1 if index & (1 << coordinate) else -1 for coordinate in range(3))
        x, z = x * yaw - z * pitch, x * pitch + z * yaw
        y, z = y * .92 - z * .39, y * .39 + z * .92
        distance = 4.1 + z * .55
        nodes.append((int(width / 2 + x * height * 2.0 / distance),
                      int(height / 2 + y * height * 1.46 / distance), z))
    for index, (x1, y1, z1) in enumerate(nodes):
        for bit in (1, 2, 4):
            other = index ^ bit
            if other < index:
                continue
            x2, y2, z2 = nodes[other]
            steps = max(abs(x1 - x2), abs(y1 - y2), 1)
            for step in range(steps + 1):
                x = round(x1 + (x2 - x1) * step / steps)
                y = round(y1 + (y2 - y1) * step / steps)
                if 0 <= y < height and 0 <= x < width:
                    grid[y][x] = "+" if step in (0, steps) else "#" if z1 + z2 < 0 else "."
    return "\n".join("".join(row).rstrip() for row in grid)


def show_blackbox():
    size = shutil.get_terminal_size((80, 24))
    width, height = min(114, size.columns - 2), min(32, size.lines - 2)
    art = [*SKULL, "", *TITLE] if width >= 60 else ["+--------+", "|  X  X  |", "|   /\\   |", "|  ====  |", "+--------+", " BLACKBOX"]
    art = "\n".join(line.strip("\n").rstrip().center(max(12, width)) for line in art).rstrip()
    if sys.stdout.isatty() and width >= 19 and height >= 8:
        print("\033[?1049h\033[?25l", end="", flush=True)
        try:
            for frame in range(49):
                print("\033[H\033[2J\033[38;5;79m" + cube_frame(width, height, frame) + "\033[0m", end="", flush=True)
                time.sleep(.043)
            for _ in range(12):
                print("\033[H\033[2J\033[38;5;159m" + art + "\033[0m", end="", flush=True)
                time.sleep(.043)
        except KeyboardInterrupt:
            pass
        finally:
            print("\033[0m\033[?25h\033[?1049l", end="", flush=True)
    print(art)


def main():
    parser = argparse.ArgumentParser(prog="box")
    commands = parser.add_subparsers(dest="command")
    commands.add_parser("me", help="Draw Blackbox")
    commands.add_parser("status", help="Show the wallpaper and game state")
    commands.add_parser("options", help="Show configurable options and current values")
    look = commands.add_parser("look", help="Turn the Idle wallpaper")
    look.add_argument("direction", choices=("left", "right", "up", "down"))
    room = commands.add_parser("room", help="Go directly to a room in Idle")
    room.add_argument("face", choices=ROOMS)
    wallpaper = commands.add_parser("wallpaper", help="Set custom artwork or restore stock")
    wallpaper.add_argument("face", choices=(*ROOMS, "cube"))
    wallpaper.add_argument("image", help="Path to a local image, or default")
    setting = commands.add_parser("set", help="Adjust an option from box options")
    setting.add_argument("option", choices=OPTIONS)
    setting.add_argument("value")
    args = parser.parse_args()
    if args.command == "me":
        show_blackbox()
    elif args.command == "status":
        print(json.dumps(json.loads(service("Status")), indent=2))
    elif args.command == "options":
        status = json.loads(service("Options"))
        for key, (kind, valid) in OPTIONS.items():
            description = "true or false" if kind is bool else " to ".join(map(str, valid)) if kind in (float, int) else ", ".join(valid)
            print(f"{key:20} {str(status.get(key)):8} {description}")
    elif args.command == "look":
        if service("IdleTurn", args.direction).strip() != "true":
            parser.error("wallpaper turns are available from an active Blackbox Idle session")
    elif args.command == "room":
        answer = service("IdleRoom", args.face).strip()
        if answer != "true":
            parser.error("room selection is available from an active Blackbox Idle session")
    elif args.command == "wallpaper":
        if args.image == "default":
            image = ""
        else:
            path = Path(args.image).expanduser().resolve()
            if not path.is_file() or path.suffix.lower() not in (".png", ".jpg", ".jpeg", ".webp"):
                parser.error("choose a local PNG, JPEG or WebP image")
            image = path.as_uri()
        key = "wallpaper_" + args.face
        service("Configure", key, json.dumps(image))
        if json.loads(service("Options")).get(key) != image:
            parser.error("Blackbox could not apply that wallpaper")
        print(args.face + " wallpaper updated")
    elif args.command == "set":
        kind, valid = OPTIONS[args.option]
        try:
            if kind is bool:
                value = {"true": True, "false": False}[args.value.lower()]
            else:
                value = kind(args.value)
                if not (valid[0] <= value <= valid[1] if kind in (float, int) else value in valid):
                    raise ValueError
        except (ValueError, KeyError):
            parser.error("invalid value. See box options for accepted values")
        service("Configure", args.option, json.dumps(value))
        current = json.loads(service("Options")).get(args.option)
        print(f"{args.option} = {current}")
    else:
        parser.print_help()


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.SubprocessError, ValueError):
        raise SystemExit("Blackbox is unavailable on this KDE session bus.")
