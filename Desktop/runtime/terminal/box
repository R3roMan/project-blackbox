class BoxParser(argparse.ArgumentParser):
    def error(self, message):
        if "invalid choice" in message:
            message = "Invalid command or value."
        print(f"box: {message.rstrip('.')}. Try box help.", file=sys.stderr)
        raise SystemExit(2)


def pet_catalog():
    return json.loads(PET_CATALOG.read_text().partition("var groups = ")[2])


def pet_help(detail="", leaf=""):
    groups = pet_catalog()
    if detail in ("", "commands"):
        if leaf in groups:
            detail = leaf
        elif leaf:
            detail = leaf
        else:
            for group, commands in groups.items():
                print(f"├─ {group:8} {len(commands)} commands   box help -pet =commands .{group}")
            print("   Syntax  pet COMMAND [ARG]   + groups of related commands   : named values")
            print("Full reference  " + PET_MANUAL.as_uri())
            return
    if detail in groups:
        for item in groups[detail]:
            print(f"├─ {item['name']:12} {item['args']:28} {item['description']}")
    else:
        match = next((entry for group in groups.values() for entry in group if entry["name"] == detail), None)
        if not match:
            raise ValueError("Unknown pet topic. Try box help -pet.")
        print(f"pet {match['name']} {match['args']}\n{match['description']}".rstrip())
    print("Full reference  " + PET_MANUAL.as_uri())


def format_type(spec):
    if isinstance(spec, str):
        return {"bool": "on or off", "text": "text", "bindings": "JSON object",
                "palette": "JSON object of #RRGGBB colours", "image": "local image or default", "folder": "local folder or default"}[spec]
    if isinstance(spec[0], type):
        return f"{'integer' if spec[0] is int else 'number'} {spec[1]}–{spec[2]}"
    return " | ".join(map(str, spec))


def as_bool(value):
    values = {"true": True, "yes": True, "on": True, "1": True,
              "false": False, "no": False, "off": False, "0": False}
    if value.lower() not in values:
        raise ValueError("Expected on or off.")
    return values[value.lower()]


def image_url(value):
    if value == "default":
        return ""
    path = Path(value).expanduser().resolve()
    if not path.is_file():
        raise ValueError("Choose a local image file.")
    return path.as_uri()


def parse_setting(key, value):
    spec = KEYS[key]
    if spec == "bool":
        return as_bool(value)
    if spec == "text":
        return "" if value == "default" else value
    if spec == "image":
        return image_url(value)
    if spec == "folder":
        if value == "default":
            return ""
        path = Path(value).expanduser().resolve()
        if not path.is_dir():
            raise ValueError("Folder not found.")
        return str(path)
    if spec in ("bindings", "palette"):
        parsed = json.loads(value)
        if not isinstance(parsed, dict):
            raise ValueError("Expected a JSON object.")
        if spec == "palette":
            for name, color in parsed.items():
                if name not in ("foreground", "background", "accent") or not isinstance(color, str) or not re.fullmatch(r"#[a-fA-F0-9]{6}", color):
                    raise ValueError("Palette keys are foreground, background, and accent. Use #RRGGBB.")
        return json.dumps(parsed, separators=(",", ":"))
    if isinstance(spec[0], type):
        number = spec[0](value)
        if spec[1] <= number <= spec[2]:
            return number
    for choice in spec:
        if isinstance(choice, (int, float)) and value.replace(".", "", 1).isdigit() and float(value) == choice:
            return choice
        if isinstance(choice, str) and value == choice:
            return choice
    raise ValueError("Expected " + format_type(spec))


def print_help(topics):
    parts = [part.lstrip("-=.+:") for part in topics if part.lstrip("-=.+:")]
    command = parts[0] if parts else ""
    detail = parts[1] if len(parts) > 1 else ""
    if command == "pet":
        pet_help(detail, parts[2] if len(parts) > 2 else "")
        return
    if command == "options" and detail in OPTIONS and len(parts) > 2:
        branch = OPTIONS[detail]
        detail = parts[2]
        if detail not in branch:
            raise ValueError("That setting is not in this section.")
    if not command:
        print("PURE CODE / BLACKBOX COMMANDS")
        for index, (name, (_, description, _)) in enumerate(VERBS.items()):
            print(f"{'└─' if index + 1 == len(VERBS) else '├─'} {name:9} {description}")
        print("\nExpand a branch with box help -options =graphics .framing or box help -pet =commands.")
    elif command == "options" and not detail:
        for section, options in OPTIONS.items():
            print(f"├─ {section:9} {len(options)} settings   box help -options ={section}")
    elif command == "options" and detail in OPTIONS:
        for name, spec in OPTIONS[detail].items():
            print(f"├─ {name:22} {format_type(spec)}")
    elif command == "options" and detail in KEYS:
        print(f"{detail}  ·  {format_type(KEYS[detail])}\n  box get {detail}\n  box set {detail} VALUE")
    elif command == "debug" and detail in DEBUG:
        print(f"box debug {detail} {DEBUG[detail]}")
        print("Requires box admin in this shell and an unstarted practice run.")
    elif command in VERBS:
        syntax, description, examples = VERBS[command]
        print(f"box {command} {syntax}\n{description}".rstrip())
        if command == "debug":
            for action, syntax in DEBUG.items():
                print(f"├─ {action:9} {syntax}")
        for example in examples:
            print("  " + example)
    else:
        raise ValueError("Unknown help topic. Run box help.")
    print("\nFull reference  " + MANUAL.as_uri())


def service(method, *args):
    return subprocess.check_output([*RPC[:3], RPC[3] + method, *args], text=True, timeout=6)


